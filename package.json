{
  "name": "gym-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:native": "tsc -b && vite build && cap sync",
    "ios": "npm run build:native && cap open ios",
    "android": "npm run build:native && cap open android",
    "typecheck": "tsc -b --noEmit",
    "test:db": "node scripts/test-migration.mjs && node scripts/test-sync-hooks.mjs && node scripts/test-calories-migration.mjs && node scripts/test-bodyfat-migration.mjs",
    "test:rec": "esbuild scripts/test-recommendation.mts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/rec.mjs --log-level=error && node node_modules/.tmp/rec.mjs",
    "test:style": "node scripts/test-style-rules.mjs",
    "test:levels": "esbuild scripts/test-muscle-group-levels.mts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/mgl.mjs --log-level=error && node node_modules/.tmp/mgl.mjs",
    "test:backup": "esbuild scripts/test-backup.mts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/backup.mjs --log-level=error && node node_modules/.tmp/backup.mjs",
    "test:workout": "esbuild scripts/test-workout-summary.mts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/workout.mjs --log-level=error && node node_modules/.tmp/workout.mjs",
    "test:past": "esbuild scripts/test-past-workouts.mts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/past.mjs --log-level=error && node node_modules/.tmp/past.mjs",
    "test": "npm run test:style && npm run test:db && npm run test:rec && npm run test:levels && npm run test:backup && npm run test:workout && npm run test:past"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.112.1",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.427.0",
    "lz-string": "^1.5.0",
    "motion": "^13.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.1"
  }
}
