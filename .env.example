# EmailJS — https://emailjs.com (gratis hasta 200 emails/mes)
# Crear una cuenta, un "Email Service" conectado a Gmail y un "Email Template"
# con variables: {{to_email}}, {{to_name}}, {{code}}
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# Supabase — https://supabase.com/dashboard
# Crear un proyecto, después Settings → API para sacar estos dos valores.
# La anon key es pública por diseño (la usa cualquier cliente, protegida
# por RLS del lado del servidor) — no es secreta, a diferencia de la
# service_role key (esa NUNCA va acá ni al frontend).
# Después de crear el proyecto, correr los 5 SQL de supabase/migrations/
# en orden (0001 a 0005) desde el SQL Editor del dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VAPID pública para Web Push — Settings → Edge Functions (o generarla
# con `npx web-push generate-vapid-keys`, y guardar la privada como
# secret de Supabase, no acá). Opcional: sin esto, la app anda igual,
# solo no ofrece recordatorios por push.
VITE_VAPID_PUBLIC_KEY=

# Spotify — https://developer.spotify.com/dashboard
# Crear una app (tipo "Web API" + "Web Playback SDK"). Login vía
# Authorization Code + PKCE (src/lib/spotifyAuth.ts): no hace falta
# Client Secret, solo el Client ID.
# En el dashboard de la app, en "Redirect URIs", cargar EXACTO (sin
# wildcards, una por vez con el botón "Add") las dos URLs que arma
# getSpotifyRedirectUri():
#   http://127.0.0.1:5173/spotify/callback          (dev)
#   https://santiagoritter.github.io/GYM-tracker/spotify/callback  (prod)
# Ojo: Spotify exige 127.0.0.1, "localhost" lo marca como no seguro.
# Para probar en dev hay que abrir la app como http://127.0.0.1:5173
# (no localhost:5173), si no el redirect_uri no matchea el registrado.
VITE_SPOTIFY_CLIENT_ID=
